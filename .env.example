# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
# Better Auth configuration
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# Access Configuration
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

ORGANIZATION_NAME=
ORGANIZATION_SLUG=

# Public client configuration (embedded at build time)
VITE_APP_TITLE=

DEFAULT_BRANCH_NAME=
DEFAULT_BRANCH_SLUG=

# Miscellaneous
VITE_APP_URL=http://localhost:3000

# Notifications
# Leave MAIL_APP_USER / MAIL_APP_PASSWORD empty to disable sending; the app
# then logs a warning and callers record `emailSent: false`.
MAIL_APP_USER=
MAIL_APP_PASSWORD=
# SMTP transport (defaults match Gmail)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
# Optional From header; falls back to MAIL_APP_USER.
MAIL_FROM=

# Facebook page feed (landing page + /posts route).
# The school's page: https://www.facebook.com/eebssbutwal
#
# Recommended — official Graph API. A Page Admin of the school's page
# generates a Page Access Token (Meta App -> Page token, never expires if
# generated as a long-lived user token), then find the numeric Page ID
# (Meta Business Suite -> Page -> About, or the graph /me/pages call).
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
# Graph API version; defaults to v23.0 when empty.
FACEBOOK_GRAPH_VERSION=
# Alternative — any RSS bridge that mirrors the page (rss.app, RSSHub, self-
# hosted). Only used when FACEBOOK_PAGE_TOKEN is unset or fails.
FACEBOOK_RSS_URL=

# Scheduled maintenance
# Set a long random value to enable GET/POST /api/cron/cleanup.
# Leave empty to disable the endpoint.
CRON_SECRET=

# File storage
# `local` stores uploads on disk; `s3` uses MinIO or any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Only used when STORAGE_DRIVER=s3 (docker compose starts MinIO with these values)
# Compose-only overrides (not read by the app): MINIO_IMAGE, MINIO_CONSOLE_PORT
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=scms
S3_SECRET_KEY=scms-secret
S3_BUCKET=scms
# Optional; when unset the driver discovers the bucket region.
S3_REGION=
