# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"
# Better Auth configuration
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate a secret key: `npx -y @better-auth/cli secret`

# Access Configuration
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

ORGANIZATION_NAME=
ORGANIZATION_SLUG=

DEFAULT_BRANCH_NAME=
DEFAULT_BRANCH_SLUG=

# Miscellaneous
VITE_APP_URL=http://localhost:3000

# Notifications
MAIL_APP_USER=
MAIL_APP_PASSWORD=

# Scheduled maintenance
# Set a long random value to enable GET/POST /api/cron/cleanup.
# Leave empty to disable the endpoint.
CRON_SECRET=

# File storage
# `local` stores uploads on disk; `s3` uses MinIO or any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads

# Only used when STORAGE_DRIVER=s3 (docker compose starts MinIO with these values)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=scms
S3_SECRET_KEY=scms-secret
S3_BUCKET=scms
