generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN

  STUDENT
  GUARDIAN

  STAFF
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum InviteType {
  STUDENT
  STAFF
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  userRoles UserRole[]

  student  Student?
  staff    Staff?
  guardian Guardian?

  activatedAt DateTime?
  invites     Invite[]

  guardianInvites GuardianInvite[]

  permissions            UserPermission[]
  uploadedFiles          FileAsset[]
  reviewedInviteRequests InviteRequest[] @relation("InviteRequestReviewer")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id String @id @default(cuid())

  name String
  slug String @unique

  logo        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  userRoles UserRole[]
  students  Student[]
  staffs    Staff[]

  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]
}

model Branch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  address String?

  phone String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  staffs    Staff[]
  userRoles UserRole[]

  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]

  @@unique([organizationId, slug])
}

model UserRole {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role Role

  createdAt DateTime @default(now())

  @@unique([userId, organizationId, role], name: "userId_organizationId_role")
}

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  admissionNo String?
  rollNo      String?

  grade   String?
  section String?

  joinedAt DateTime?

  status           StudentStatus     @default(ACTIVE)
  guardianStudents GuardianStudent[]
  guardianInvites  GuardianInvite[]

  enrollments           Enrollment[]
  attendanceRecords     AttendanceRecord[]
  transportAssignments  TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String?

  designation String
  department  String?

  joinedAt DateTime?

  status StaffStatus @default(ACTIVE)

  courses           Course[]
  attendanceSessions AttendanceSession[] @relation("AttendanceTakenBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guardianStudents GuardianStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianStudent {
  id String @id @default(cuid())

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Invite {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type InviteType

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

model GuardianInvite {
  id String @id @default(cuid())

  token String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String  @default("Guardian")
  isPrimary Boolean @default(false)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([userId])
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
  GUARDIANS
}

model Notice {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  title   String
  slug    String @unique
  summary String?
  body    String
  category String?
  coverImage String?

  audience NoticeAudience @default(ALL)

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([organizationId, branchId])
}

model Event {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  title       String
  slug        String @unique
  description String?
  location    String?
  coverImage  String?

  startsAt DateTime
  endsAt   DateTime?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startsAt])
  @@index([organizationId, branchId])
}

model Club {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  name        String
  slug        String @unique
  description String?
  meetingSchedule String?
  coverImage  String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([organizationId, branchId])
}

enum PermissionKey {
  MANAGE_DASHBOARD
  MANAGE_INVITES
  MANAGE_DIRECTORY
  MANAGE_CONTENT
  MANAGE_ACADEMICS
  MANAGE_ATTENDANCE
  MANAGE_TRANSPORT
  MANAGE_PERMISSIONS
}

model UserPermission {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission PermissionKey
  granted    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

enum InviteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InviteRequest {
  id String @id @default(cuid())

  name  String
  email String
  type  InviteType

  message String?
  status  InviteRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("InviteRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Classroom {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name     String
  building String?
  floor    String?
  capacity Int?
  notes    String?

  isActive Boolean @default(true)

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model Course {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  grade       String?
  section     String?
  schedule    String?

  teacherId String?
  teacher   Staff? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([branchId, grade, section])
}

model Enrollment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  date  DateTime
  topic String?

  takenById String?
  takenBy   Staff? @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, date])
  @@index([date])
}

model AttendanceRecord {
  id String @id @default(cuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(PRESENT)
  note   String?

  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum TransportDirection {
  PICKUP
  DROPOFF
  BOTH
}

model TransportRoute {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  description   String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  capacity      Int?

  isActive Boolean @default(true)

  stops       TransportStop[]
  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model TransportStop {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name       String
  sortOrder  Int     @default(0)
  pickupTime String?
  dropoffTime String?
  latitude   Float?
  longitude  Float?

  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, name])
  @@index([routeId, sortOrder])
}

model TransportAssignment {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  stopId String?
  stop   TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  direction TransportDirection @default(BOTH)
  isActive  Boolean            @default(true)

  activeFrom DateTime?
  activeTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, routeId, direction])
  @@index([routeId])
  @@index([studentId])
}

model FileAsset {
  id String @id @default(cuid())

  key          String @unique
  url          String
  originalName String
  mimeType     String
  size         Int

  uploadedById String?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([uploadedById])
}
