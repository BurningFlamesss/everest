generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN

  STUDENT
  GUARDIAN

  STAFF
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum InviteType {
  STUDENT
  STAFF
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  userRoles UserRole[]

  student  Student?
  staff    Staff?
  guardian Guardian?

  activatedAt DateTime?
  invites     Invite[]

  guardianInvites GuardianInvite[]

  permissions            UserPermission[]
  uploadedFiles          FileAsset[]
  reviewedInviteRequests InviteRequest[] @relation("InviteRequestReviewer")
  handledContactMessages ContactMessage[] @relation("ContactMessageHandler")
  notifications          Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id String @id @default(cuid())

  name String
  slug String @unique

  logo        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  userRoles UserRole[]
  students  Student[]
  staffs    Staff[]

  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]
  academicYears   AcademicYear[]
}

model Branch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  address String?

  phone String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  staffs    Staff[]
  userRoles UserRole[]

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]

  @@unique([organizationId, slug])
}

model UserRole {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role Role

  createdAt DateTime @default(now())

  @@unique([userId, organizationId, role], name: "userId_organizationId_role")
}

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  admissionNo String?
  rollNo      String?

  grade   String?
  section String?

  joinedAt DateTime?

  status           StudentStatus     @default(ACTIVE)
  guardianStudents GuardianStudent[]
  guardianInvites  GuardianInvite[]

  enrollments           Enrollment[]
  attendanceRecords     AttendanceRecord[]
  transportAssignments  TransportAssignment[]
  marks                 Mark[]
  invoices              Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String?

  designation String
  department  String?

  joinedAt DateTime?

  status StaffStatus @default(ACTIVE)

  courses           Course[]
  attendanceSessions AttendanceSession[] @relation("AttendanceTakenBy")
  timetableSlots    TimetableSlot[]
  marksEntered      Mark[] @relation("MarkEnteredBy")
  paymentsReceived  Payment[] @relation("PaymentReceivedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guardianStudents GuardianStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianStudent {
  id String @id @default(cuid())

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Invite {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type InviteType

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

model GuardianInvite {
  id String @id @default(cuid())

  token String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String  @default("Guardian")
  isPrimary Boolean @default(false)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([userId])
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
  GUARDIANS
}

model Notice {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  title   String
  slug    String @unique
  summary String?
  body    String
  category String?
  coverImage String?

  attachments Attachment[]

  audience NoticeAudience @default(ALL)

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([organizationId, branchId])
}

model Event {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  title       String
  slug        String @unique
  description String?
  location    String?
  coverImage  String?

  attachments Attachment[]

  startsAt DateTime
  endsAt   DateTime?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startsAt])
  @@index([organizationId, branchId])
}

model Club {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  name        String
  slug        String @unique
  description String?
  meetingSchedule String?
  coverImage  String?

  attachments Attachment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([organizationId, branchId])
}

enum PermissionKey {
  MANAGE_DASHBOARD
  MANAGE_INVITES
  MANAGE_DIRECTORY
  MANAGE_CONTENT
  MANAGE_ACADEMICS
  MANAGE_ATTENDANCE
  MANAGE_TRANSPORT
  MANAGE_PERMISSIONS
  MANAGE_INBOX
  MANAGE_TIMETABLE
  MANAGE_EXAMS
  MANAGE_FEES
}

model UserPermission {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // "global" or the branch id; PostgreSQL unique indexes treat NULLs as
  // distinct, so this key makes the scope part of the uniqueness constraint.
  scopeKey String @default("global")

  permission PermissionKey
  granted    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permission, scopeKey])
  @@index([userId])
  @@index([branchId])
}

enum InviteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InviteRequest {
  id String @id @default(cuid())

  name  String
  email String
  type  InviteType

  message String?
  status  InviteRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("InviteRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Classroom {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name     String
  building String?
  floor    String?
  capacity Int?
  notes    String?

  isActive Boolean @default(true)

  courses Course[]
  timetableSlots TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model Course {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  grade       String?
  section     String?
  schedule    String?

  teacherId String?
  teacher   Staff? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  examSchedules      ExamSchedule[]
  assignments        Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([branchId, grade, section])
}

model Enrollment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  date  DateTime
  topic String?

  takenById String?
  takenBy   Staff? @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, date])
  @@index([date])
}

model AttendanceRecord {
  id String @id @default(cuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(PRESENT)
  note   String?

  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum TransportDirection {
  PICKUP
  DROPOFF
  BOTH
}

model TransportRoute {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  description   String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  capacity      Int?

  isActive Boolean @default(true)

  stops       TransportStop[]
  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model TransportStop {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name       String
  sortOrder  Int     @default(0)
  pickupTime String?
  dropoffTime String?
  latitude   Float?
  longitude  Float?

  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, name])
  @@index([routeId, sortOrder])
}

model TransportAssignment {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  stopId String?
  stop   TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  direction TransportDirection @default(BOTH)
  isActive  Boolean            @default(true)

  activeFrom DateTime?
  activeTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, routeId, direction])
  @@index([routeId])
  @@index([studentId])
}

model FileAsset {
  id String @id @default(cuid())

  key          String @unique
  url          String
  originalName String
  mimeType     String
  size         Int

  uploadedById String?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([uploadedById])
}

enum ContactMessageStatus {
  NEW
  HANDLED
}

/// Public contact-form submissions. Persisted before any email attempt so a
/// mail outage never loses an enquiry.
model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  subject String
  message String

  status ContactMessageStatus @default(NEW)

  handledAt   DateTime?
  handledById String?
  handledBy   User?     @relation("ContactMessageHandler", fields: [handledById], references: [id], onDelete: SetNull)

  /// SHA-256 of the request IP; the raw address is never stored.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model RolePermission {
  id String @id @default(cuid())

  role Role

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // "global" or the branch id; see UserPermission.scopeKey.
  scopeKey String @default("global")

  permission PermissionKey
  granted    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permission, scopeKey])
  @@index([role])
  @@index([branchId])
}

model Attachment {
  id String @id @default(cuid())

  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  noticeId String?
  notice   Notice? @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  label String?

  createdAt DateTime @default(now())

  @@index([fileAssetId])
  @@index([noticeId])
  @@index([eventId])
  @@index([clubId])
  @@index([assignmentId])
}

// ---------------------------------------------------------------------------
// Academic core
// ---------------------------------------------------------------------------

model AcademicYear {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  startsOn DateTime
  endsOn   DateTime
  isActive Boolean  @default(false)

  terms          Term[]
  timetableSlots TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Term {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name     String
  startsOn DateTime
  endsOn   DateTime

  exams         Exam[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model TimetableSlot {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  staffId String?
  staff   Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  /// 1 = Monday … 7 = Sunday.
  weekday     Int
  periodIndex Int
  startsAt    String
  endsAt      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, courseId, weekday, periodIndex])
  @@index([academicYearId, weekday, periodIndex])
  @@index([staffId, weekday])
  @@index([classroomId, weekday])
}

model Exam {
  id String @id @default(cuid())

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  name      String
  startsOn  DateTime
  endsOn    DateTime
  isPublished Boolean @default(false)

  schedules ExamSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, name])
  @@index([termId, startsOn])
}

model ExamSchedule {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  date     DateTime
  startsAt String?
  maxMarks Int      @default(100)
  room     String?

  marks Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, courseId])
  @@index([date])
}

model Mark {
  id String @id @default(cuid())

  scheduleId String
  schedule   ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score Float

  enteredById String?
  enteredBy   Staff? @relation("MarkEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([scheduleId, studentId])
  @@index([studentId])
}

model Assignment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title        String
  instructions String
  dueAt        DateTime

  attachments Attachment[]

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, dueAt])
}

// ---------------------------------------------------------------------------
// Finance (phase 1: invoices and payments, no gateway)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
}

model FeeStructure {
  id String @id @default(cuid())

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  name      String
  grade     String?
  section   String?
  /// Amount in the smallest currency unit (paise/cents).
  amount    Int
  dueDate   DateTime

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId, grade, section])
}

model Invoice {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Restrict)

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  amount  Int
  status  InvoiceStatus @default(UNPAID)
  dueDate DateTime

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, feeStructureId])
  @@index([status, dueDate])
  @@index([studentId])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Int
  method    String
  reference String?
  paidAt    DateTime @default(now())

  receivedById String?
  receivedBy   Staff? @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Communication & operations
// ---------------------------------------------------------------------------

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  body    String?
  refType String?
  refId   String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model MailLog {
  id String @id @default(cuid())

  recipient String
  subject   String
  template  String?
  ok        Boolean
  error     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GalleryImage {
  id String @id @default(cuid())

  title    String?
  caption  String?
  imageUrl String
  sortOrder Int @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}
