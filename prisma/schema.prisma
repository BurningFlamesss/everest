generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN

  STUDENT
  GUARDIAN

  STAFF
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  RETIRED
}

enum InviteType {
  STUDENT
  STAFF
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  userRoles UserRole[]

  student  Student?
  staff    Staff?
  guardian Guardian?

  activatedAt DateTime?
  invites     Invite[]

  guardianInvites        GuardianInvite[] @relation("GuardianInviteUser")
  permissions            UserPermission[]
  uploadedFiles          FileAsset[]
  reviewedInviteRequests InviteRequest[]  @relation("InviteRequestReviewer")
  handledContactMessages ContactMessage[] @relation("ContactMessageHandler")
  notifications          Notification[]

  @@unique([email])
  @@index([emailVerified])
  @@index([activatedAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id String @id @default(cuid())

  name String
  slug String @unique

  logo        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  userRoles UserRole[]
  students  Student[]
  staffs    Staff[]

  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]
  academicYears   AcademicYear[]

  @@index([slug])
}

model Branch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String
  slug String

  address String?

  phone String?
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  staffs    Staff[]
  userRoles UserRole[]

  classes      SchoolClass[]
  applications Application[]

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  classrooms      Classroom[]
  courses         Course[]
  transportRoutes TransportRoute[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
}

model UserRole {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role Role

  createdAt DateTime @default(now())

  @@unique([userId, organizationId, role], name: "userId_organizationId_role")
}

model Student {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  admissionNo String?
  rollNo      String?

  grade   String?
  section String?

  joinedAt DateTime?

  // Extended profile fields (migrated from the legacy mock layer)
  gender           String?
  dateOfBirth      String?
  phone            String?
  address          String?
  city             String?
  bloodGroup       String?
  nationality      String?
  guardianName     String?
  guardianPhone    String?
  guardianEmail    String?
  guardianRelation String?
  houseName        String?

  status           StudentStatus     @default(ACTIVE)
  guardianStudents GuardianStudent[]
  guardianInvites  GuardianInvite[]

  classId String?
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  attendance AttendanceRecord[]
  invoices   Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments          Enrollment[]
  transportAssignments TransportAssignment[]
  marks                Mark[]

  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([grade, section])
  @@index([admissionNo])
  @@index([classId])
}

model Staff {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  employeeId String?

  designation String
  department  String?

  joinedAt DateTime?

  // Extended profile fields (migrated from the legacy mock layer)
  phone           String?
  qualification   String?
  experienceYears Int?
  employmentType  String? // full_time | part_time | contract
  dateOfBirth     String?
  address         String?
  gender          String?

  status StaffStatus @default(ACTIVE)

  taughtClasses SchoolClass[]      @relation("ClassTeacher")
  attendance    AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses            Course[]
  attendanceSessions AttendanceSession[] @relation("AttendanceTakenBy")
  timetableSlots     TimetableSlot[]
  marksEntered       Mark[]              @relation("MarkEnteredBy")
  paymentsReceived   Payment[]           @relation("PaymentReceivedBy")

  @@index([branchId, status])
  @@index([organizationId, status])
  @@index([department])
  @@index([employeeId])
}

model Guardian {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guardianStudents GuardianStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuardianStudent {
  id String @id @default(cuid())

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation  String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Invite {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type InviteType

  expiresAt DateTime
  usedAt    DateTime?

  /// Pending profile fields (grade/section/designation/etc.) captured at invite
  /// time and applied when the invitee activates their account.
  payload Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([type])
}

model GuardianInvite {
  id String @id @default(cuid())

  token String @unique

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Email the guardian invite was sent to, so activation can attach it to the
  /// (possibly newly-created) guardian user account.
  guardianEmail String?

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation("GuardianInviteUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Academic structure & operations (migrate the legacy mock layer onto Prisma)
// ---------------------------------------------------------------------------

/// A homeroom / class section (e.g. "Grade 7 · A").
model SchoolClass {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name         String
  grade        String
  section      String
  roomNo       String?
  capacity     Int     @default(40)
  academicYear String?

  classTeacherId String?
  classTeacher   Staff?  @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  order Int @default(0)

  students   Student[]
  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([grade, section])
  @@map("school_class")
}

enum AttendancePersonType {
  STUDENT
  STAFF
}

enum AttendanceState {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// A single attendance mark for a student or staff member on a given day.
model AttendanceRecord {
  id String @id @default(cuid())

  date       DateTime             @db.Date
  personType AttendancePersonType
  state      AttendanceState
  note       String?

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// ScMS session-based attendance (nullable: Everest's daily records leave
  /// these unset, ScMS's per-session records set them).
  sessionId String?
  session   AttendanceSession? @relation("SessionRecords", fields: [sessionId], references: [id], onDelete: Cascade)

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  classId String?
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  markedBy String
  markedAt DateTime @default(now())

  @@index([classId, date])
  @@index([studentId, date])
  @@index([staffId, date])
  @@index([date])
  @@map("attendance_record")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
}

/// An admission application submitted by a prospective student.
model Application {
  id            String @id @default(cuid())
  applicationNo String @unique

  applicantName String
  dateOfBirth   String?
  gender        String?
  gradeApplied  String

  email   String?
  phone   String?
  address String?

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  previousSchool String?
  previousGrade  String?
  entranceScore  Int?

  source String @default("website") // website | walk_in | referral | agent

  status ApplicationStatus @default(PENDING)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  documents Json @default("[]") // DocumentFile[]
  notes     Json @default("[]") // ApplicationNote[]
  timeline  Json @default("[]") // TimelineEntry[]

  convertedStudentId String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([gradeApplied])
  @@index([branchId])
  @@map("application")
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
  VOID
}

/// A fee invoice issued to a student.
model Invoice {
  id        String @id @default(cuid())
  invoiceNo String @unique

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  termLabel  String?
  amount     Int
  amountPaid Int     @default(0)

  items Json @default("[]") // { label, amount }[]

  issuedDate DateTime?
  dueDate    DateTime?

  status InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  termId         String?
  term           Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  payments       Payment[]

  @@index([studentId])
  @@index([status])
  @@map("invoice")
}

enum WebsitePageKey {
  home
  about
  contact
  other
  faculty
  login
  activate
  courses
  facilities
  gallery
  calendar
  resources
  result
  transportation
  notices
  scholarship
  posts
  course_finder
  admissions
  clubs
  events
}

enum WebsitePageStatus {
  draft
  published
}

enum BlockType {
  hero
  headline
  intro
  stats
  cta
  featured_events
  featured_notices
  rich_text
  history
  mission_vision
  principal_message
  facilities
  achievements
  contact_details
  office_hours
  social_links
  map
  announcements
  gallery_grid
  faculty
  academics
  admissions_info
  auth_visual
  auth_intro
  auth_form
  auth_contact
  faculty_header
  faculty_leadership
  faculty_directory
  landing_hero
  landing_facts
  discover_cards
  chapters
  department_list
  landing_section_headings
}

model WebsitePage {
  id                    String            @id @default(cuid())
  key                   WebsitePageKey    @unique
  title                 String
  path                  String
  status                WebsitePageStatus @default(draft)
  hasUnpublishedChanges Boolean           @default(true)
  seoTitle              String?
  seoDescription        String?
  seoKeywords           String?
  publishedAt           DateTime?
  updatedAt             DateTime          @updatedAt
  updatedBy             String
  createdAt             DateTime          @default(now())

  blocks ContentBlock[]

  @@index([status])
  @@index([path])
  @@map("website_page")
}

model ContentBlock {
  id        String    @id @default(cuid())
  type      BlockType
  label     String
  visible   Boolean   @default(true)
  order     Int
  fields    Json
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  pageId String
  page   WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@index([pageId, visible])
  @@map("content_block")
}

/// Public faculty directory. Mirrors the frontend Person shape so the
/// faculty-page-detail route is driven from the database instead of static files.
model FacultyMember {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  role          String
  department    String
  qualification String
  experience    String
  subjects      Json
  email         String
  extension     String
  officeHours   String
  bio           String
  joined        String
  leadership    Boolean  @default(false)
  rank          Int?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadership])
  @@index([department])
  @@map("faculty_member")
}

/// Public notice-board content, mirroring the frontend Notice shape. Complex
/// fields (paragraphs, bullets, tables, attachments) are stored as JSON.
model Notice {
  id          String   @id @default(cuid())
  ref         String
  title       String
  category    String
  dateAd      String
  dateBs      String
  audience    String
  issuedBy    String
  summary     String
  body        Json
  bullets     Json?
  table       Json?
  attachments Json
  pinned      Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([pinned])
  @@map("notice")
}

/// Public scholarship schemes, mirroring the frontend Scholarship shape.
model Scholarship {
  id          String   @id @default(cuid())
  ref         String
  name        String
  nepaliName  String
  category    String
  coverage    Int
  award       String
  amountNpr   Int
  seats       Int
  deadlineAd  String
  deadlineBs  String
  appliesTo   String
  summary     String
  description String
  eligibility Json
  benefits    Json
  documents   Json
  process     Json
  renewal     String
  contact     String
  spotlight   Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("scholarship")
}

/// Photo albums shown in the gallery page.
model Album {
  id        String   @id @default(cuid())
  event     String
  year      String
  category  String
  date      String?
  photos    Json // Array of { src, alt, width, height }
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([year])
  @@map("album")
}

/// Campus facilities matching frontend complex shapes
model Facility {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Campus")
  block        String   @default("")
  blurb        String   @default("")
  description  String   @default("")
  image        String   @default("")
  gallery      Json     @default("[]") // string[]
  stats        Json     @default("[]") // { label, value }[]
  hours        String   @default("")
  inCharge     String   @default("")
  studentsLove String   @default("")
  since        String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("facility")
}

/// Downloadable resources for students/guardians.
model Resource {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  fileSize  String
  kind      String   @default("PDF")
  audience  String   @default("All")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("resource")
}

/// Board results tracking academic excellence over years.
model BoardResult {
  id             String   @id @default(cuid())
  board          String // 'SEE' or 'NEB'
  year           String // e.g. '2079'
  appeared       Int
  passed         Int
  distinction    Int
  firstDivision  Int
  secondDivision Int
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([board, year])
  @@map("board_result")
}

/// Bus routes for the transportation page.
model BusRoute {
  id          String   @id @default(cuid())
  busNumber   String
  driverName  String
  driverPhone String
  stops       Json // Array of strings or {time, stopName}
  feeMonthly  Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("bus_route")
}

/// Calendar and school events.
/// Academic programs matching frontend complex shapes
model Program {
  id          String   @id @default(cuid())
  level       String
  code        String
  title       String
  stream      String?
  duration    String
  seats       Int
  medium      String
  eligibility String
  summary     String
  description String
  highlights  Json // string[]
  outcomes    Json // string[]
  careers     Json // string[]
  subjects    Json // Subject[]
  fees        Json // FeeLine[]
  image       String
  routineKey  String
  spotlight   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("program")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  /// Stable seed/source key (e.g. "e-dashain") for idempotent reseeding.
  slug        String?  @unique
  title       String
  titleNe     String?
  description String?
  startDate   DateTime
  endDate     DateTime
  /// Authored Bikram Sambat dates ("2083-06-24") — the school's source of truth.
  startBs     String?
  endBs       String?
  /// Public-page taxonomy: exam | holiday | festival | event | admission.
  kind        String?
  category    String // Holiday, Examination, General
  term        String?

  // Extended fields (migrated from the legacy mock layer)
  status               String  @default("scheduled") // draft | scheduled | ongoing | completed | cancelled
  allDay               Boolean @default(true)
  startTime            String?
  endTime              String?
  location             String?
  coverImage           String?
  organizerName        String?
  registrationRequired Boolean @default(false)
  capacity             Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([category])
  @@index([status])
  @@map("calendar_event")
}

model AcademicYear {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  startsOn DateTime
  endsOn   DateTime
  isActive Boolean  @default(false)

  terms          Term[]
  timetableSlots TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Term {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name     String
  startsOn DateTime
  endsOn   DateTime

  exams         Exam[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Exam {
  id String @id @default(cuid())

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  name        String
  startsOn    DateTime
  endsOn      DateTime
  isPublished Boolean  @default(false)

  schedules ExamSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([termId, name])
  @@index([termId, startsOn])
}

model ExamSchedule {
  id String @id @default(cuid())

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  date     DateTime
  startsAt String?
  maxMarks Int      @default(100)
  room     String?

  marks Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, courseId])
  @@index([date])
}

model Mark {
  id String @id @default(cuid())

  scheduleId String
  schedule   ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score Float

  enteredById String?
  enteredBy   Staff?  @relation("MarkEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([scheduleId, studentId])
  @@index([studentId])
}

model Assignment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title        String
  instructions String
  dueAt        DateTime

  attachments Attachment[]

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, dueAt])
}

model AttendanceSession {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  date  DateTime
  topic String?

  takenById String?
  takenBy   Staff?  @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  records AttendanceRecord[] @relation("SessionRecords")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, date])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Club {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  name            String
  slug            String  @unique
  description     String?
  meetingSchedule String?
  coverImage      String?

  attachments Attachment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([organizationId, branchId])
}

model Event {
  id String @id @default(cuid())

  organizationId String?
  branchId       String?

  title       String
  slug        String  @unique
  description String?
  location    String?
  coverImage  String?

  attachments Attachment[]

  startsAt DateTime
  endsAt   DateTime?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startsAt])
  @@index([organizationId, branchId])
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
  GUARDIANS
}

enum PermissionKey {
  MANAGE_DASHBOARD
  MANAGE_INVITES
  MANAGE_DIRECTORY
  MANAGE_CONTENT
  MANAGE_ACADEMICS
  MANAGE_ATTENDANCE
  MANAGE_TRANSPORT
  MANAGE_PERMISSIONS
  MANAGE_INBOX
  MANAGE_TIMETABLE
  MANAGE_EXAMS
  MANAGE_FEES
}

model UserPermission {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // "global" or the branch id; PostgreSQL unique indexes treat NULLs as
  // distinct, so this key makes the scope part of the uniqueness constraint.
  scopeKey String @default("global")

  permission PermissionKey
  granted    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permission, scopeKey])
  @@index([userId])
  @@index([branchId])
}

model RolePermission {
  id String @id @default(cuid())

  role Role

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // "global" or the branch id; see UserPermission.scopeKey.
  scopeKey String @default("global")

  permission PermissionKey
  granted    Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permission, scopeKey])
  @@index([role])
  @@index([branchId])
}

enum InviteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InviteRequest {
  id String @id @default(cuid())

  name  String
  email String
  type  InviteType

  message String?
  status  InviteRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("InviteRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Enrollment {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

model Classroom {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name     String
  building String?
  floor    String?
  capacity Int?
  notes    String?

  isActive Boolean @default(true)

  courses        Course[]
  timetableSlots TimetableSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model Course {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  grade       String?
  section     String?
  schedule    String?

  teacherId String?
  teacher   Staff?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  examSchedules      ExamSchedule[]
  assignments        Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([branchId, grade, section])
}

model FileAsset {
  id String @id @default(cuid())

  key          String @unique
  url          String
  originalName String
  mimeType     String
  size         Int

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  attachments Attachment[]

  createdAt DateTime @default(now())

  @@index([uploadedById])
}

model Attachment {
  id String @id @default(cuid())

  fileAssetId String
  fileAsset   FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  noticeId String?
  notice   ScmsNotice? @relation("NoticeAttachments", fields: [noticeId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  label String?

  createdAt DateTime @default(now())

  @@index([fileAssetId])
  @@index([noticeId])
  @@index([eventId])
  @@index([clubId])
  @@index([assignmentId])
}

enum ContactMessageStatus {
  NEW
  HANDLED
}

model ContactMessage {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  subject String
  message String

  status ContactMessageStatus @default(NEW)

  handledAt   DateTime?
  handledById String?
  handledBy   User?     @relation("ContactMessageHandler", fields: [handledById], references: [id], onDelete: SetNull)

  /// SHA-256 of the request IP; the raw address is never stored.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum TransportDirection {
  PICKUP
  DROPOFF
  BOTH
}

model TransportRoute {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  description   String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  capacity      Int?

  isActive Boolean @default(true)

  stops       TransportStop[]
  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, branchId])
}

model TransportStop {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  name        String
  sortOrder   Int     @default(0)
  pickupTime  String?
  dropoffTime String?
  latitude    Float?
  longitude   Float?

  assignments TransportAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, name])
  @@index([routeId, sortOrder])
}

model TransportAssignment {
  id String @id @default(cuid())

  routeId String
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  stopId String?
  stop   TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  direction TransportDirection @default(BOTH)
  isActive  Boolean            @default(true)

  activeFrom DateTime?
  activeTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, routeId, direction])
  @@index([routeId])
  @@index([studentId])
}

model FeeStructure {
  id String @id @default(cuid())

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  name    String
  grade   String?
  section String?
  /// Amount in the smallest currency unit (paise/cents).
  amount  Int
  dueDate DateTime

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([termId, grade, section])
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount    Int
  method    String
  reference String?
  paidAt    DateTime @default(now())

  receivedById String?
  receivedBy   Staff?  @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  body    String?
  refType String?
  refId   String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model MailLog {
  id String @id @default(cuid())

  recipient String
  subject   String
  template  String?
  ok        Boolean
  error     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GalleryImage {
  id String @id @default(cuid())

  title       String?
  caption     String?
  imageUrl    String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model TimetableSlot {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  /// 1 = Monday … 7 = Sunday.
  weekday     Int
  periodIndex Int
  startsAt    String
  endsAt      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, courseId, weekday, periodIndex])
  @@index([academicYearId, weekday, periodIndex])
  @@index([staffId, weekday])
  @@index([classroomId, weekday])
}

/// ScMS publishing fields grafted onto the Everest CMS Notice row. `ref`,
/// bilingual dates, bullets and table are Everest-only; a ScMS-published
/// notice simply leaves them null/empty.
model ScmsNotice {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  summary        String?
  body           String
  category       String?
  coverImage     String?
  audience       NoticeAudience @default(ALL)
  isPublished    Boolean        @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  organizationId String?
  branchId       String?
  authorId       String?
  attachments    Attachment[]   @relation("NoticeAttachments")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isPublished, publishedAt])
  @@index([audience])
}
